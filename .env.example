# Copie para .env e ajuste. NUNCA versione o .env.
# Valores abaixo servem só para desenvolvimento local, com dados sintéticos.

# PostgreSQL (compose local)
POSTGRES_DB=clinicos
POSTGRES_USER=clinicos
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Backend (perfil api ou worker)
SPRING_PROFILES_ACTIVE=api
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/clinicos
SPRING_DATASOURCE_USERNAME=clinicos
SPRING_DATASOURCE_PASSWORD=change-me

# E-mail local (Mailpit)
MAIL_HOST=localhost
MAIL_PORT=1025
MAILPIT_UI_PORT=8025

# WhatsApp local (mock)
WHATSAPP_API_URL=http://localhost:8089
WHATSAPP_API_TOKEN=change-me

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
